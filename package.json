{
  "name": "@yesimagent/root",
  "version": "0.0.3",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages-ext/*"
  ],
  "type": "module",
  "scripts": {
    "build": "yakumo build",
    "clean": "yakumo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "publish": "for p in packages/*/ packages-ext/*/; do npm publish \"$(cd \"$p\" && bun pm pack --destination \"$(mktemp -d)\" --quiet)\"; done",
    "test": "yakumo vitest"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "bumpp": "^12.3.0",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.77.0",
    "typescript": "^6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "yakumo": "^3.2.1",
    "yakumo-esbuild": "^3.0.2",
    "yakumo-tsc": "^3.0.1",
    "yakumo-vitest": "^1.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.json": [
      "oxfmt --write"
    ]
  }
}
